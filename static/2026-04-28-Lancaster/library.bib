@article{recasensEffectStressSpeech2015,
  title = {The {{Effect}} of {{Stress}} and {{Speech Rate}} on {{Vowel Coarticulation}} in {{Catalan Vowel}}–{{Consonant}}–{{Vowel Sequences}}},
